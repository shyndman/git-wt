#!/usr/bin/env zsh

emulate -LR zsh
setopt NO_UNSET PIPE_FAIL

typeset -gr GIT_WT_PROGRAM_NAME='git wt'
typeset -gr GIT_WT_INIT_SCRIPT_NAME='.wtinit'

_git_wt_log_error() {
  print -ru2 -- "${GIT_WT_PROGRAM_NAME}: $1"
}

_git_wt_print_usage() {
  print -r -- 'usage: git wt <worktree> [--force]'
  print -r -- '       git wt --rm <worktree> [--force]'
  print -r -- '       git wt --init'
  print -r -- '       git wt --completions'
}

_git_wt_repository_root() {
  local inside_worktree
  local common_directory

  if ! inside_worktree=$(command git rev-parse --is-inside-work-tree 2>/dev/null) || [[ $inside_worktree != true ]]; then
    _git_wt_log_error 'the current directory is not inside a Git worktree'
    return 1
  fi

  if ! common_directory=$(command git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    _git_wt_log_error 'Git did not return the common directory'
    return 1
  fi

  print -r -- "${common_directory:h}"
}

_git_wt_validate_name() {
  local -r name=$1

  if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
    _git_wt_log_error "invalid worktree name: ${name:-<empty>}"
    return 1
  fi
}


_git_wt_write_init_script() {
  local -r init_script=$1

  if [[ -e $init_script ]]; then
    return 0
  fi

  cat > "$init_script" <<'EOF'
#!/usr/bin/env zsh
# git wt runs this script after it creates a worktree.
# The current directory is the new worktree root.
# A failure leaves the worktree in place and makes git wt fail.
EOF
  local -r exit_status=$?
  if (( exit_status != 0 )); then
    _git_wt_log_error "could not create ${init_script}"
    return "$exit_status"
  fi
}

_git_wt_command_init() {
  if (( $# != 0 )); then
    _git_wt_log_error '--init does not accept arguments'
    return 2
  fi

  local root
  if ! root=$(_git_wt_repository_root); then
    return 1
  fi

  if ! _git_wt_write_init_script "${root}/${GIT_WT_INIT_SCRIPT_NAME}"; then
    return 1
  fi
}

_git_wt_parse_name_and_force() {
  local argument
  local name=''
  local force=false

  for argument in "$@"; do
    case $argument in
      --force)
        force=true
        ;;
      --*)
        _git_wt_log_error "unknown option: ${argument}"
        return 2
        ;;
      *)
        if [[ -n $name ]]; then
          _git_wt_log_error 'expected one worktree name'
          return 2
        fi
        name=$argument
        ;;
    esac
  done

  if [[ -z $name ]]; then
    _git_wt_log_error 'a worktree name is required'
    return 2
  fi

  if ! _git_wt_validate_name "$name"; then
    return 2
  fi

  reply=("$name" "$force")
}

_git_wt_worktrees_directory() {
  local -r encoded_root=${${1#/}//\//--}
  print -r -- "${HOME}/.local/share/git-wt/${encoded_root}"
}

_git_wt_resolve_worktree() {
  local -r root=$1 name=$2
  local external_path
  external_path="$(_git_wt_worktrees_directory "$root")/${name}"
  local candidate exists_status

  for candidate in "$external_path" "${root}/.worktrees/${name}"; do
    _git_wt_worktree_exists "$candidate"
    exists_status=$?
    if (( exists_status == 0 )); then
      print -r -- "$candidate"
      return 0
    fi
    (( exists_status == 1 )) || return "$exists_status"
  done
  return 1
}

_git_wt_worktree_exists() {
  local -r worktree_path=$1
  local listing
  local line

  if ! listing=$(command git worktree list --porcelain 2>/dev/null); then
    _git_wt_log_error 'Git could not list worktrees'
    return 2
  fi

  for line in "${(f)listing}"; do
    if [[ $line == "worktree ${worktree_path}" ]]; then
      return 0
    fi
  done

  return 1
}

_git_wt_command_open() {
  local -a reply
  _git_wt_parse_name_and_force "$@" || return $?

  local -r name=$reply[1]
  local -r force=$reply[2]
  local root
  if ! root=$(_git_wt_repository_root); then
    return 1
  fi

  local -r worktrees_directory=$(_git_wt_worktrees_directory "$root")
  local worktree_path
  local -r init_script="${root}/${GIT_WT_INIT_SCRIPT_NAME}"

  worktree_path=$(_git_wt_resolve_worktree "$root" "$name")
  local -r exists_status=$?
  if (( exists_status == 0 )); then
    if ! builtin cd -- "$worktree_path"; then
      _git_wt_log_error "could not change directory to ${worktree_path}"
      return 1
    fi
    return 0
  fi
  if (( exists_status != 1 )); then
    return 1
  fi
  worktree_path="${worktrees_directory}/${name}"

  if ! mkdir --parents -- "$worktrees_directory"; then
    _git_wt_log_error "could not create ${worktrees_directory}"
    return 1
  fi

  local -a git_arguments=(worktree add --quiet)
  if [[ $force == true ]]; then
    git_arguments+=(--force)
  fi
  git_arguments+=(-- "$worktree_path")

  print -ru2 -- 'creating worktree…'
  if ! command git "${git_arguments[@]}"; then
    _git_wt_log_error "Git could not add worktree ${name}"
    return 1
  fi

  if [[ -f $init_script ]]; then
    (builtin cd -- "$worktree_path" && zsh "$init_script")
    local -r exit_status=$?
    if (( exit_status != 0 )); then
      _git_wt_log_error "${GIT_WT_INIT_SCRIPT_NAME} failed for worktree ${name}; the worktree remains at ${worktree_path}"
      return "$exit_status"
    fi
  fi

  if ! builtin cd -- "$worktree_path"; then
    _git_wt_log_error "could not change directory to ${worktree_path}"
    return 1
  fi
}

_git_wt_command_remove() {
  local -a reply
  _git_wt_parse_name_and_force "$@" || return $?

  local -r name=$reply[1]
  local -r force=$reply[2]
  local root
  if ! root=$(_git_wt_repository_root); then
    return 1
  fi

  local worktree_path
  if ! worktree_path=$(_git_wt_resolve_worktree "$root" "$name"); then
    _git_wt_log_error "no managed worktree named ${name}"
    return 1
  fi
  local -a git_arguments=(worktree remove)
  local previous_directory=''

  if [[ $force == true ]]; then
    git_arguments+=(--force)
  fi
  git_arguments+=(-- "$worktree_path")

  if [[ ${PWD:A} == ${worktree_path:A} || ${PWD:A} == ${worktree_path:A}/* ]]; then
    previous_directory=$PWD
    if ! builtin cd -- "$root"; then
      _git_wt_log_error "could not change directory to ${root} before removal"
      return 1
    fi
  fi

  if ! command git "${git_arguments[@]}"; then
    _git_wt_log_error "Git could not remove worktree ${name}"
    if [[ -n $previous_directory ]] && ! builtin cd -- "$previous_directory"; then
      _git_wt_log_error "could not restore directory ${previous_directory}"
    fi
    return 1
  fi
}

_git_wt_managed_worktrees() {
  local common_directory repository_root managed_prefix legacy_prefix line worktree_path name
  local -a worktrees=()

  common_directory=$(command git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  repository_root=${common_directory:h}
  managed_prefix="$(_git_wt_worktrees_directory "$repository_root")/"
  legacy_prefix="${repository_root}/.worktrees/"

  while IFS= read -r line; do
    if [[ $line == worktree\ * ]]; then
      worktree_path=${line#worktree }
      name=''
      if [[ $worktree_path == ${managed_prefix}* ]]; then
        name=${worktree_path#$managed_prefix}
      elif [[ $worktree_path == ${legacy_prefix}* ]]; then
        name=${worktree_path#$legacy_prefix}
      fi
      if [[ -n $name && $name != */* && ${worktrees[(Ie)$name]} == 0 ]]; then
        worktrees+=("$name")
      fi
    fi
  done < <(command git worktree list --porcelain 2>/dev/null)

  _describe -t worktrees 'managed worktree' worktrees
}

_git-wt() {
  if (( CURRENT == 2 )) && [[ -z ${words[CURRENT]} ]]; then
    local -a options=(
      '--init:initialize worktree files'
      '--completions:print Zsh completions'
      '--rm:remove a managed worktree'
      '--force:pass force behavior to git worktree'
    )
    _describe -O -t options 'option' options
    _git_wt_managed_worktrees
    return
  fi

  _arguments -s \
    '--init[initialize worktree files]' \
    '--completions[print Zsh completions]' \
    '--rm[remove a managed worktree]' \
    '--force[pass force behavior to git worktree]' \
    '1:worktree name:_git_wt_managed_worktrees'
}

_git_wt_command_completions() {
  if (( $# != 0 )); then
    _git_wt_log_error '--completions does not accept arguments'
    return 2
  fi

  print -r -- '#compdef git-wt'
  functions _git_wt_worktrees_directory _git_wt_managed_worktrees _git-wt
  local -r exit_status=$?
  if (( exit_status != 0 )); then
    _git_wt_log_error 'could not write completions'
    return "$exit_status"
  fi
}

_git_wt_main() {
  if (( $# == 0 )); then
    _git_wt_print_usage >&2
    return 2
  fi

  case $1 in
    --init)
      shift
      _git_wt_command_init "$@"
      ;;
    --completions)
      shift
      _git_wt_command_completions "$@"
      ;;
    --rm)
      shift
      _git_wt_command_remove "$@"
      ;;
    *)
      _git_wt_command_open "$@"
      ;;
  esac
}

if [[ $ZSH_EVAL_CONTEXT == toplevel ]]; then
  _git_wt_main "$@"
fi
