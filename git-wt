#!/usr/bin/env zsh

emulate -LR zsh
setopt NO_UNSET PIPE_FAIL

readonly PROGRAM_NAME='git wt'
readonly WORKTREES_DIRECTORY_NAME='.worktrees'
readonly INIT_SCRIPT_NAME='.wtinit'
readonly IGNORE_ENTRY='/.worktrees/'

log_error() {
  print -ru2 -- "${PROGRAM_NAME}: $1"
}

print_usage() {
  print -r -- 'usage: git wt <init|add|rm|completions> [arguments]'
}

repository_root() {
  local inside_worktree
  local common_directory

  if ! inside_worktree=$(git rev-parse --is-inside-work-tree 2>/dev/null) || [[ $inside_worktree != true ]]; then
    log_error 'the current directory is not inside a Git worktree'
    return 1
  fi

  if ! common_directory=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    log_error 'Git did not return the common directory'
    return 1
  fi

  print -r -- "${common_directory:h}"
}

validate_name() {
  local -r name=$1

  if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
    log_error "invalid worktree name: ${name:-<empty>}"
    return 1
  fi
}

append_ignore_entry() {
  local -r ignore_file=$1
  local line
  local found=false
  local last_character

  if [[ -f $ignore_file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == $IGNORE_ENTRY ]]; then
        found=true
        break
      fi
    done < "$ignore_file"
  fi

  if [[ $found == true ]]; then
    return 0
  fi

  if [[ -s $ignore_file ]]; then
    if ! last_character=$(tail --bytes=1 -- "$ignore_file"); then
      log_error "could not read ${ignore_file}"
      return 1
    fi
    if [[ -n $last_character ]]; then
      print >> "$ignore_file" || {
        log_error "could not add a line break to ${ignore_file}"
        return 1
      }
    fi
  fi

  print -r -- "$IGNORE_ENTRY" >> "$ignore_file" || {
    log_error "could not update ${ignore_file}"
    return 1
  }
}

write_init_script() {
  local -r init_script=$1

  if [[ -e $init_script ]]; then
    return 0
  fi

  cat > "$init_script" <<'EOF'
#!/usr/bin/env zsh
# git wt runs this script after it creates a worktree.
# The current directory is the new worktree root.
# A failure leaves the worktree in place and makes git wt add fail.
EOF
  local -r exit_status=$?
  if (( exit_status != 0 )); then
    log_error "could not create ${init_script}"
    return "$exit_status"
  fi
}

command_init() {
  if (( $# != 0 )); then
    log_error 'init does not accept arguments'
    return 2
  fi

  local root
  if ! root=$(repository_root); then
    return 1
  fi

  if ! append_ignore_entry "${root}/.gitignore"; then
    return 1
  fi

  if ! write_init_script "${root}/${INIT_SCRIPT_NAME}"; then
    return 1
  fi
}

parse_name_and_force() {
  local argument
  local name=''
  local force=false

  for argument in "$@"; do
    case $argument in
      --force)
        force=true
        ;;
      --*)
        log_error "unknown option: ${argument}"
        return 2
        ;;
      *)
        if [[ -n $name ]]; then
          log_error 'expected one worktree name'
          return 2
        fi
        name=$argument
        ;;
    esac
  done

  if [[ -z $name ]]; then
    log_error 'a worktree name is required'
    return 2
  fi

  if ! validate_name "$name"; then
    return 2
  fi

  reply=("$name" "$force")
}

command_add() {
  local -a reply
  parse_name_and_force "$@" || return $?

  local -r name=$reply[1]
  local -r force=$reply[2]
  local root
  if ! root=$(repository_root); then
    return 1
  fi

  local -r worktrees_directory="${root}/${WORKTREES_DIRECTORY_NAME}"
  local -r worktree_path="${worktrees_directory}/${name}"
  local -r init_script="${root}/${INIT_SCRIPT_NAME}"
  local -a git_arguments=(worktree add)

  if ! mkdir --parents -- "$worktrees_directory"; then
    log_error "could not create ${worktrees_directory}"
    return 1
  fi

  if [[ $force == true ]]; then
    git_arguments+=(--force)
  fi
  git_arguments+=(-- "$worktree_path")

  if ! git "${git_arguments[@]}"; then
    log_error "Git could not add worktree ${name}"
    return 1
  fi

  if [[ -f $init_script ]]; then
    (cd -- "$worktree_path" && zsh "$init_script")
    local -r exit_status=$?
    if (( exit_status != 0 )); then
      log_error "${INIT_SCRIPT_NAME} failed for worktree ${name}; the worktree remains at ${worktree_path}"
      return "$exit_status"
    fi
  fi
}

command_remove() {
  local -a reply
  parse_name_and_force "$@" || return $?

  local -r name=$reply[1]
  local -r force=$reply[2]
  local root
  if ! root=$(repository_root); then
    return 1
  fi

  local -r worktree_path="${root}/${WORKTREES_DIRECTORY_NAME}/${name}"
  local -a git_arguments=(worktree remove)

  if [[ $force == true ]]; then
    git_arguments+=(--force)
  fi
  git_arguments+=(-- "$worktree_path")

  if ! git "${git_arguments[@]}"; then
    log_error "Git could not remove worktree ${name}"
    return 1
  fi
}

command_completions() {
  if (( $# != 0 )); then
    log_error 'completions does not accept arguments'
    return 2
  fi

  cat <<'EOF'
#compdef git-wt
#description manage worktrees under the primary checkout

_git-wt() {
  local curcontext="$curcontext" state state_descr line
  local -A opt_args
  local ret=1

  _arguments -C \
    ':subcommand:->command' \
    '*::argument:->argument' && ret=0

  case $state in
    command)
      local -a commands=(
        'init:initialize worktree files'
        'add:add a managed worktree'
        'rm:remove a managed worktree'
        'completions:print Zsh completions'
      )
      _describe -t commands 'git wt command' commands && ret=0
      ;;
    argument)
      case $line[1] in
        add)
          _arguments \
            '--force[pass force behavior to git worktree add]' \
            ':worktree name:' && ret=0
          ;;
        rm)
          _arguments \
            '--force[remove a worktree with uncommitted changes or submodules]' \
            ':worktree name:_git_wt_managed_worktrees' && ret=0
          ;;
        init|completions)
          _message 'no arguments' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_git_wt_managed_worktrees() {
  local common_directory repository_root managed_prefix line path name
  local -a worktrees=()

  common_directory=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  repository_root=${common_directory:h}
  managed_prefix="${repository_root}/.worktrees/"

  while IFS= read -r line; do
    if [[ $line == worktree\ * ]]; then
      path=${line#worktree }
      if [[ $path == ${managed_prefix}* ]]; then
        name=${path#$managed_prefix}
        if [[ -n $name && $name != */* ]]; then
          worktrees+=("$name")
        fi
      fi
    fi
  done < <(git worktree list --porcelain 2>/dev/null)

  _describe -t worktrees 'managed worktree' worktrees
}

_git-wt "$@"
EOF
  local -r exit_status=$?
  if (( exit_status != 0 )); then
    log_error 'could not write completions'
    return "$exit_status"
  fi
}

main() {
  if (( $# == 0 )); then
    print_usage >&2
    return 2
  fi

  local -r command=$1
  shift

  case $command in
    init)
      command_init "$@"
      ;;
    add)
      command_add "$@"
      ;;
    rm)
      command_remove "$@"
      ;;
    completions)
      command_completions "$@"
      ;;
    *)
      log_error "unknown command: ${command}"
      print_usage >&2
      return 2
      ;;
  esac
}

main "$@"
